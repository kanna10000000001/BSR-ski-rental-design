<view class="app">
  <view class="hero">
    <view class="brand">BSR <text class="brand-small">SKI RENTALS</text></view>
    <view class="hero-title"><view>让每一件装备，</view><view>都有清晰的旅程。</view></view>
    <view class="hero-bottom"><text>{{demo ? '本机演示 · 虚构数据' : '腾讯云 · 业务环境'}}</text><text bindtap="switchRole">{{roleLabel || '未授权'}} {{demo ? ' ⇄' : ''}}</text></view>
  </view>
  <view class="toolbar">
    <picker range="{{stores}}" range-key="name" value="{{storeIndex}}" bindchange="store"><view class="store-picker">⌖ {{storeName || '选择门店'}} ▾</view></picker>
    <text class="link" bindtap="load">刷新数据</text>
  </view>
  <view wx:if="{{error}}" class="error"><text>{{error}}</text><button size="mini" bindtap="identity">我的身份ID</button><button size="mini" bindtap="initialize">首次初始化</button><button size="mini" bindtap="load">重试</button></view>
  <view wx:if="{{loading}}" class="empty">正在读取业务记录…</view>
  <block wx:if="{{state}}">
    <view wx:if="{{tab === 'home'}}">
      <view class="section-head"><text class="heading">今日工作台</text><text class="sub">{{storeName}} · 实时状态</text></view>
      <view class="stats">
        <view class="stat"><text class="stat-number">{{stats.available}}</text><text>本店可租装备</text></view>
        <view class="stat"><text class="stat-number">{{stats.rented}}</text><text>全店租出单件</text></view>
        <view class="stat"><text class="stat-number">{{stats.repairing}}</text><text>{{user.role === 'contractor' ? '我的未结工单' : '未结维修单'}}</text></view>
      </view>
      <view wx:if="{{user.role !== 'contractor'}}" class="card income"><view><text class="eyebrow">累计登记收款 · 非微信支付到账</text><view class="amount">¥ {{stats.revenue}}</view></view><text class="badge">{{stats.active}} 份生效合同</text></view>
      <view class="section-head"><text class="heading">快速办理</text><text class="sub">从业务目标开始</text></view>
      <view class="quick-grid" wx:if="{{user.role !== 'contractor'}}">
        <view class="quick primary" data-type="contractCreate" bindtap="open"><text class="quick-symbol">＋</text><text>开立租赁合同</text><text class="quick-note">选配 · 签字 · 凭据登记</text></view>
        <view class="quick" data-id="contracts" bindtap="tab"><text class="quick-symbol">↩</text><text>归还与换装</text><text class="quick-note">按单件记录，保留历史</text></view>
        <view class="quick" data-type="repairCreate" bindtap="open"><text class="quick-symbol">⌁</text><text>提交维修</text><text class="quick-note">停租并分配承包商</text></view>
        <view class="quick" data-id="equipment" bindtap="tab"><text class="quick-symbol">◇</text><text>查找装备</text><text class="quick-note">查看位置、归属与状态</text></view>
      </view>
      <view wx:else class="card"><view class="heading">维修承包商工作区</view><text class="muted">仅显示分配给你的维修单。请在维修页登记开工和完成，验收由门店员工执行。</text><button class="primary" data-id="repairs" bindtap="tab">进入我的维修单</button></view>
      <view class="card notice"><view class="heading">课堂演示说明</view><text>本版为员工受理端，顾客由员工代录。收款仅登记外部已核验凭据，未接入微信支付。身体资料请用虚构数据。专业调校由人员完成，系统只记录确认。</text></view>
    </view>
    <view wx:if="{{tab !== 'home'}}" class="search"><input placeholder="搜索编号、姓名、规格或记录" value="{{search}}" bindinput="search"/></view>
    <view wx:if="{{tab === 'equipment'}}">
      <view class="section-head"><text class="heading">装备档案</text><button wx:if="{{user.role === 'manager'}}" class="small primary" data-type="equipmentAdd" bindtap="open">＋ 入库</button></view>
      <view wx:for="{{equipment}}" wx:key="id" class="card equipment-card">
        <view class="row"><text class="eyebrow">{{item.category}} · #{{item.id}}</text><text class="badge {{item.status === '可租' ? 'green' : ''}}">{{item.status}}</text></view>
        <view class="row item-title"><text>{{item.name}}</text><text class="price">¥{{item.price}}<text class="muted">/天</text></text></view>
        <view class="muted">{{item.spec}} {{item.level ? ' · ' + item.level : ' · 配件无技能等级'}}</view>
        <view class="detail-grid"><text>归属 {{item.homeName}}</text><text>位置 {{item.locationName}}</text></view>
        <view class="actions" wx:if="{{user.role !== 'contractor'}}">
          <button wx:if="{{item.status === '待检查'}}" size="mini" data-type="equipmentInspect" data-id="{{item.id}}" bindtap="open">整备放行</button>
          <button wx:if="{{item.status === '可租' || item.status === '待检查' || item.status === '故障待报修'}}" size="mini" data-type="repairCreate" data-id="{{item.id}}" bindtap="open">报修</button>
          <button wx:if="{{user.role === 'manager' && (item.status === '可租' || item.status === '待检查')}}" size="mini" data-type="equipmentMove" data-id="{{item.id}}" bindtap="open">调拨接收</button>
        </view>
      </view>
      <view wx:if="{{!equipment.length}}" class="empty">暂无符合条件的装备</view>
    </view>
    <view wx:if="{{tab === 'contracts'}}">
      <view class="section-head"><text class="heading">租赁合同</text><button wx:if="{{user.role !== 'contractor'}}" class="small primary" data-type="contractCreate" bindtap="open">＋ 开单</button></view>
      <view wx:for="{{contracts}}" wx:key="id" wx:for-item="contract" class="card">
        <view class="row"><text class="eyebrow">{{contract.id}}</text><text class="badge">{{contract.status}}</text></view>
        <view class="item-title row"><text>{{contract.customerName}}</text><text class="price">¥{{contract.amount}}</text></view>
        <view class="muted">{{contract.days}}天 · {{contract.level}} · 原签约 {{contract.employeeName}}</view>
        <view wx:for="{{contract.items}}" wx:for-item="segment" wx:key="id" class="segment">
          <view class="row"><text>{{segment.name}} #{{segment.equipmentId}}</text><text>¥{{segment.rate}}/天</text></view>
          <view class="muted">{{segment.returnText}}</view>
          <view class="actions" wx:if="{{!segment.returnAt}}"><button size="mini" data-type="returnItem" data-contract="{{contract.id}}" data-segment="{{segment.id}}" bindtap="open">登记归还</button><button size="mini" data-type="exchangePrepare" data-contract="{{contract.id}}" data-segment="{{segment.id}}" bindtap="open">换装</button></view>
        </view>
        <view wx:for="{{contract.changes}}" wx:key="id" wx:for-item="change" class="change"><text>{{change.reason}} · {{change.status}} · 差额 ¥{{change.amount}}</text><view wx:if="{{change.status === '待结算'}}" class="actions"><button size="mini" data-type="exchangeConfirm" data-contract="{{contract.id}}" data-change="{{change.id}}" bindtap="open">确认结算借出</button><button size="mini" data-type="exchangeCancel" data-contract="{{contract.id}}" data-change="{{change.id}}" bindtap="open">取消换装</button></view></view>
      </view>
      <view wx:if="{{!contracts.length}}" class="empty">暂无合同。请在当前门店选择可租装备开单。</view>
    </view>
    <view wx:if="{{tab === 'repairs'}}">
      <view class="section-head"><text class="heading">{{user.role === 'contractor' ? '我的维修单' : '维修与验收'}}</text><button wx:if="{{user.role !== 'contractor'}}" class="small primary" data-type="repairCreate" bindtap="open">＋ 报修</button></view>
      <view wx:for="{{repairs}}" wx:key="id" class="card">
        <view class="row"><text class="eyebrow">{{item.id}}</text><text class="badge">{{item.status}}</text></view>
        <view class="item-title">{{item.equipmentName}} #{{item.equipmentId}}</view><view class="muted">{{item.description}}</view>
        <view class="segment">{{item.contractorName}}<view class="muted">冻结费率 ¥{{item.rateText}}/小时 · 累计 {{item.minutes}}分钟 · 费用 ¥{{item.costText}}</view></view>
        <view class="actions">
          <button wx:if="{{user.role === 'contractor' && item.status === '待处理'}}" size="mini" data-type="repairStart" data-id="{{item.id}}" bindtap="open">登记开工</button>
          <button wx:if="{{user.role === 'contractor' && item.status === '维修中'}}" size="mini" data-type="repairComplete" data-id="{{item.id}}" bindtap="open">提交完成</button>
          <block wx:if="{{user.role !== 'contractor' && item.status === '待验收'}}"><button size="mini" data-type="repairAccept" data-id="{{item.id}}" bindtap="open">实物回店并验收</button><button size="mini" data-type="repairReject" data-id="{{item.id}}" bindtap="open">退回返工</button></block>
        </view>
        <view wx:for="{{item.history}}" wx:key="index" wx:for-item="record" class="history">{{record.at}} · {{record.note}}</view>
      </view>
      <view wx:if="{{!repairs.length}}" class="empty">暂无维修单</view>
    </view>
    <view wx:if="{{tab === 'manage'}}">
      <view class="section-head"><text class="heading">人员与业务记录</text></view>
      <view class="card"><view class="row"><text>当前身份：{{roleLabel}}</text><text class="link" bindtap="identity">我的身份ID</text></view><view class="muted">{{demo ? '切换身份仅供本机演示，云端身份由管理员配置。' : '身份和权限由腾讯云后台配置，客户端不能自行变更。'}}</view></view>
      <block wx:if="{{user.role !== 'contractor'}}">
        <view wx:if="{{user.role === 'manager'}}" class="actions management-actions"><button size="mini" data-type="shiftAdd" bindtap="open">安排班次</button><button size="mini" data-type="employeeAdd" bindtap="open">新增员工</button><button size="mini" data-type="contractorAdd" bindtap="open">新增承包商</button><button size="mini" data-type="rateAdd" bindtap="open">新增费率</button></view>
        <view class="card"><view class="heading">员工班次</view><view wx:for="{{shifts}}" wx:key="id" class="segment"><view>{{item.name}} · {{item.storeName}}</view><view class="muted">{{item.date}} {{item.start}}—{{item.end}}</view></view><view wx:if="{{!shifts.length}}" class="muted">暂无班次。同一员工每日最多一班。</view></view>
        <view class="card"><view class="heading">客户索引</view><view wx:for="{{customers}}" wx:key="id" class="segment"><view>{{item.name}} · {{item.id}}</view><view class="muted">{{item.email}} · {{item.phone}}</view></view><view wx:if="{{!customers.length}}" class="muted">首次开单后自动建立客户档案；回头客使用ID与邮箱核对。</view></view>
        <view class="card"><view class="heading">员工档案</view><view wx:for="{{employees}}" wx:key="id" class="segment"><view>{{item.name}} · {{item.id}}</view><view class="muted">{{item.notes}}</view></view></view>
        <view class="card"><view class="heading">承包商费率版本</view><view wx:for="{{contractors}}" wx:key="id" class="segment"><view>{{item.name}} · {{item.id}}</view><view class="muted">{{item.ratesText}}</view></view></view>
        <view class="card"><view class="heading">最近操作</view><view wx:for="{{audits}}" wx:key="id" class="history">{{item.actor}} · {{item.action}} · {{item.target}}<view>{{item.at}}</view></view></view>
      </block>
      <button wx:if="{{demo || user.role === 'manager'}}" class="reset" bindtap="initialize">{{demo ? '重置本机演示数据' : '首次初始化教学数据（已有数据不覆盖）'}}</button>
    </view>
  </block>
  <view class="bottom-nav"><view wx:for="{{tabs}}" wx:key="id" class="nav-item {{tab === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="tab"><text class="nav-icon">{{item.icon}}</text><text>{{item.label}}</text></view></view>
  <view wx:if="{{modal}}" class="overlay" catchtouchmove="noop">
    <view class="sheet">
      <view class="sheet-head"><text class="heading">{{modal.title}}</text><text bindtap="close" class="close">×</text></view>
      <scroll-view scroll-y class="sheet-body">
        <view class="notice form-notice" wx:if="{{modal.action === 'contractCreate'}}">当前借出门店：{{storeName}}。请使用虚构客户资料。金额按单件日价×天数计算；只有已签字、外部付款核验和专业交付检查完成后才提交。</view>
        <view class="notice form-notice" wx:if="{{modal.action === 'exchangePrepare'}}">提交后会保存旧件真实归还，并预留新件。付费升级按含当天的剩余租赁日补差价；之后在合同内确认结算或取消换装。</view>
        <view wx:for="{{fields}}" wx:key="key" class="field">
          <view class="field-label">{{item.label}}</view>
          <picker wx:if="{{item.kind === 'pick'}}" range="{{item.options}}" range-key="label" value="{{item.index || 0}}" data-key="{{item.key}}" bindchange="choose"><view class="field-input">{{item.chosen}} ▾</view></picker>
          <switch wx:elif="{{item.kind === 'switch'}}" checked="{{form[item.key]}}" color="#167b6c" data-key="{{item.key}}" bindchange="toggle"/>
          <input wx:else class="field-input" type="{{item.kind}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" maxlength="160" placeholder="请输入"/>
        </view>
        <view wx:if="{{modal.action === 'contractCreate'}}" class="equipment-picks"><view class="heading">选择本店可租装备 · {{selected.length}}件</view><view wx:for="{{pickEquipment}}" wx:key="id" class="pick {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectEquipment"><view>{{item.selected ? '✓' : '○'}} {{item.name}} #{{item.id}}</view><text class="muted">{{item.spec}} · ¥{{item.price}}/天</text></view><view wx:if="{{!pickEquipment.length}}" class="muted">当前门店没有可租装备</view><view class="quote">所选日租合计 ¥{{selectedTotal}} × {{form.days || 0}}天</view></view>
        <view class="sheet-spacer"></view>
      </scroll-view>
      <view class="sheet-footer"><button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">{{saving ? '正在保存' : '确认提交'}}</button><text class="muted">{{demo ? '保存在本机演示数据中' : '由云函数校验权限与业务规则后保存'}}</text></view>
    </view>
  </view>
</view>
